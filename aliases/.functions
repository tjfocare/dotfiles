kill-port() {
  port_no=$1
  kill $(sudo lsof -t -i:${port_no})
}

find-port() {
  port_no=$1
  sudo lsof -i :${port_no}
}

function update_brew() {
  if command -v brew &>/dev/null; then
    echo 'Updating packages with Homebrew...'
    brew update
    brew upgrade
    brew cleanup
  fi
}

ecs_fetch_task_definition() {
  case $1 in
  uat)
    ARN="arn:aws:ecs:ap-southeast-2:153298309278:task-definition/uat-rtdnf-infrastructure-cfn-templates-RtdnfCoreServiceStack-KWEB2V8RONDP-TaskDefinition-4O5RAUS5PGLB"
    ;;
  stage)
    ARN="arn:aws:ecs:ap-southeast-2:153298309278:task-definition/stage-rtdnf-infrastructure-cfn-templates-RtdnfCoreServiceStack-11EM7KRBEVVJU-TaskDefinition-1FQDYSKXM8V1Z"
    ;;
  prod)
    ARN="arn:aws:ecs:ap-southeast-2:153298309278:task-definition/prod-rtdnf-infrastructure-cfn-templates-RtdnfCoreServiceStack-1HGP0FTD0E3F9-TaskDefinition-OPZZM6VCKT8J"
    ;;
  *)
    echo "Invalid environment. Please specify uat, stage, or prod."
    return 1
    ;;
  esac

  aws ecs describe-task-definition --task-definition "$ARN" --query 'taskDefinition.containerDefinitions[*].image' --output text
}

aws-mfa() {
  local code="$1"
  [ -z "$code" ] && { echo "usage: aws-mfa 123456"; return 1; }

  unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN

  local serial creds
  serial=$(aws iam list-mfa-devices --query 'MFADevices[0].SerialNumber' --output text) || return 1
  creds=$(aws sts get-session-token \
            --serial-number "$serial" \
            --token-code "$code" \
            --duration-seconds 43200 \
            --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken,Expiration]' \
            --output text) || return 1

  export AWS_ACCESS_KEY_ID=$(echo "$creds" | cut -f1)
  export AWS_SECRET_ACCESS_KEY=$(echo "$creds" | cut -f2)
  export AWS_SESSION_TOKEN=$(echo "$creds" | cut -f3)
  export AWS_SESSION_EXPIRY=$(echo "$creds" | cut -f4)
  echo "Session valid 12h. Identity:"
  aws sts get-caller-identity --query Arn --output text
}

aws-mfa-clear() {
  unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SESSION_EXPIRY
  echo "Session credentials cleared."
}

aws-mfa-check() {
  [ -z "$AWS_SESSION_EXPIRY" ] && { echo "No MFA session."; return 1; }
  local now exp
  now=$(date -u +%s)
  exp=$(date -u -d "$AWS_SESSION_EXPIRY" +%s 2>/dev/null || date -u -jf "%Y-%m-%dT%H:%M:%S+00:00" "$AWS_SESSION_EXPIRY" +%s)
  if [ "$now" -ge "$exp" ]; then
    aws-mfa-clear
    return 1
  fi
  echo "Session valid for $(( (exp - now) / 60 )) more minutes."
}
