[alias]
	st = status
	ci = commit -v
	co = checkout
	d = diff -- . ':!package-lock.json'
	ds = diff --staged
	df = diff --name-only
	merged = !git-merged
	s = status
[user]
	name = Tom Focareta
	email = tjfocare@gmail.com
	# email = tomf@teamrtd.com
[core]
	excludesfile = ~/.gitignore_global
[push]
	default = current
[pull]
	ff = only
	rebase = false
[log]
	date = local
# [url "https://github.com/"]
# 	insteadOf = git@github.com:
# [url "https://"]
# 	insteadOf = git://
[includeIf "gitdir:/Users/tfoc/repositories"]
	email = "tjfocare@gmail.com"
[includeIf "gitdir:/Users/tomfocareta/Repositories"]
	email = "tomf@teamrtd.com"
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	line-numbers = true
	navigate = true    # use n and N to move between diff sections
	side-by-side = true
	# delta detects terminal colors automatically; set one of these to disable auto-detection
	# dark = true
	# light = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default