[alias]
	st = status
	ci = commit -v
	co = checkout
	d = diff -- . ':!package-lock.json'
	ds = diff --staged
	df = diff --name-only
	merged = !git-merged
	s = status
[user]
	name = Tom Focareta
	# email = tjfocare@gmail.com
	# email = tomf@teamrtd.com
[core]
	excludesfile = ~/.gitignore_global
	pager = delta
[push]
	default = current
[pull]
	ff = only
	rebase = false
[log]
	date = local
[includeIf "gitdir:/Users/tfoc/repositories/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:/Users/tomfocareta/Repositories/"]
	path = ~/.gitconfig-rtd
[interactive]
	diffFilter = delta --color-only
[delta]
	line-numbers = true
	navigate = true    # use n and N to move between diff sections
	side-by-side = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default